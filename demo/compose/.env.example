# Copy to .env to override demo defaults.
#
# DEMO_HOST must match the certificate DNS name. For the generated self-signed
# certificate the default is fine. For a real certificate, set DEMO_HOST to the
# domain in the certificate and place server.crt/server.key in ./certs/.
DEMO_HOST=tls-origin
DEMO_PORT=443
TLS_DAYS=14
CHECK_TIME=5
ALERT_THRESHOLD=30
ALERT_INTERVAL=5
APP_PORT=5000
TLS_PORT=8443
PROMETHEUS_PORT=9090
